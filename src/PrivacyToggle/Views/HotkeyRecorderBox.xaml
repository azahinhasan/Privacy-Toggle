<UserControl x:Class="PrivacyToggle.Views.HotkeyRecorderBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand"
             MinWidth="220" Height="38">
    <Border x:Name="Frame" CornerRadius="6" BorderThickness="1" Padding="12,0"
            Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource ControlBorder}">
        <Grid>
            <TextBlock x:Name="Display" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock x:Name="Badge" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Text="Click to change" />
        </Grid>
    </Border>
</UserControl>
