<UserControl x:Class="PrivacyToggle.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PrivacyToggle.Views">
    <UserControl.Resources>
        <Style TargetType="ToolTip" BasedOn="{StaticResource ThemedToolTip}" />
    </UserControl.Resources>
    <StackPanel>
        <!-- ============ Header ============ -->
        <DockPanel Margin="0,0,6,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                <Button x:Name="ExportButton" Style="{StaticResource SubtleButton}" Content="Export" Click="Export_Click"
                        ToolTip="Save the history of the selected range as a CSV file" />
                <Button x:Name="PrivacyButton" Style="{StaticResource SubtleButton}" Content="Privacy settings" Margin="10,0,0,0"
                        Click="Privacy_Click" ToolTip="Windows privacy settings for the microphone, camera and network">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Microphone privacy" Click="MicPrivacy_Click" />
                            <MenuItem Header="Camera privacy" Click="CamPrivacy_Click" />
                            <MenuItem Header="Network and firewall" Click="NetPrivacy_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Activity" FontSize="30" Margin="0" />
                    <Border Margin="10,4,0,0" Padding="6,1,6,2" CornerRadius="5" VerticalAlignment="Center"
                            BorderThickness="2" BorderBrush="{DynamicResource Ink}" Background="#C9B6FF">
                        <TextBlock Text="BETA" FontSize="11" FontWeight="Black" Foreground="#2B1D4F" />
                    </Border>
                    <Border x:Name="InfoIcon" Width="20" Height="20" CornerRadius="10" Margin="10,4,0,0" VerticalAlignment="Center"
                            BorderThickness="2" BorderBrush="{DynamicResource Ink}" Background="{DynamicResource Accent}" Cursor="Help"
                            ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="30000">
                        <TextBlock Text="i" FontSize="11" FontWeight="Black" Foreground="{DynamicResource AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        <Border.ToolTip>
                            <ToolTip MaxWidth="360">
                                <TextBlock TextWrapping="Wrap"
                                           Text="PrivacyToggle combines Windows' usage records with what it sees directly: apps recording from a microphone, apps connecting to the camera, and the bytes each app sends and receives over the network (counted by the helper service). It keeps 7 days of history while it runs. Time while a device is muted or off isn't counted. Everything stays on this PC." />
                            </ToolTip>
                        </Border.ToolTip>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"
                           Text="What's using your microphone, camera and network — right now and over time." />
            </StackPanel>
        </DockPanel>

        <!-- ============ Right now ============ -->
        <DockPanel Margin="0,22,6,10">
            <TextBlock x:Name="NowSummary" DockPanel.Dock="Right" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="NowDot" Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource StatusOn}" />
                <TextBlock Text="Right now" FontSize="16" FontWeight="ExtraBold" Margin="8,0,0,1" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>
        <!-- One to three columns (wrapping on narrow windows); cards in a row share its height. -->
        <Grid x:Name="Cards" />
        <!-- Announces (once) when a new app starts using the camera or microphone. -->
        <TextBlock x:Name="LiveAnnouncer" Height="0" Focusable="False" />

        <!-- ============ History ============ -->
        <DockPanel Margin="0,10,6,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <RadioButton x:Name="ViewTimeline" Style="{StaticResource SegmentSmall}" GroupName="ActView" Content="Timeline" IsChecked="True" Checked="View_Checked" />
                <RadioButton x:Name="ViewList" Style="{StaticResource SegmentSmall}" GroupName="ActView" Content="List" Margin="0" Checked="View_Checked" />
            </StackPanel>
            <TextBlock Text="History" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,0,6,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Hint}" Text="Sort" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="SortBox" Style="{StaticResource Dropdown}" SelectedIndex="0" SelectionChanged="Sort_Changed">
                    <ComboBoxItem Content="Live first, then recent" />
                    <ComboBoxItem Content="Most data" />
                    <ComboBoxItem Content="Longest mic time" />
                    <ComboBoxItem Content="Name" />
                </ComboBox>
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
                <RadioButton x:Name="Range1h" Style="{StaticResource SegmentSmall}" GroupName="ActRange" Content="1h" Checked="Range_Checked" Margin="0,0,6,6" />
                <RadioButton x:Name="Range6h" Style="{StaticResource SegmentSmall}" GroupName="ActRange" Content="6h" Checked="Range_Checked" Margin="0,0,6,6" />
                <RadioButton x:Name="Range24h" Style="{StaticResource SegmentSmall}" GroupName="ActRange" Content="24h" Checked="Range_Checked" Margin="0,0,6,6" />
                <RadioButton x:Name="Range7d" Style="{StaticResource SegmentSmall}" GroupName="ActRange" Content="7d" Checked="Range_Checked" Margin="0,0,6,6" />
                <Border Width="2" Height="22" Margin="6,0,12,6" VerticalAlignment="Center" Background="{DynamicResource SectionDivider}" />
                <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" GroupName="ActFilter" Content="All" IsChecked="True" Checked="Filter_Checked" />
                <RadioButton x:Name="FilterMic" Style="{StaticResource Chip}" GroupName="ActFilter" Checked="Filter_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="MicChipGlyph" Focusable="False" />
                        <TextBlock Text="Microphone" Margin="5,0,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FilterCam" Style="{StaticResource Chip}" GroupName="ActFilter" Checked="Filter_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="CamChipGlyph" Focusable="False" />
                        <TextBlock Text="Camera" Margin="5,0,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FilterNet" Style="{StaticResource Chip}" GroupName="ActFilter" Checked="Filter_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="NetChipGlyph" Focusable="False" />
                        <TextBlock Text="Network" Margin="5,0,0,0" />
                    </StackPanel>
                </RadioButton>
            </WrapPanel>
        </DockPanel>

        <!-- ============ Timeline / list ============ -->
        <!-- Scrolls sideways inside its box when the window is narrow; the mouse wheel still scrolls the page. -->
        <Border CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Ink}" Background="{DynamicResource PanelBg}"
                Effect="{DynamicResource HardShadowSmall}" Margin="0,0,6,10">
            <ScrollViewer x:Name="HistoryScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="HistoryScroll_PreviewMouseWheel">
                <Grid x:Name="ContentHost" MinWidth="760" Margin="12,12,12,10">
                    <!-- timeline -->
                    <Grid x:Name="TimelineHost">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="Legend" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,6" />
                        <v:HistoryAxis x:Name="Axis" Grid.Column="1" Margin="0,0,0,6" />
                        <v:HistoryBackdrop x:Name="Backdrop" Grid.Row="1" Grid.Column="1" />
                        <ItemsControl x:Name="Rows" Grid.Row="1" Grid.ColumnSpan="2" Focusable="False" />
                    </Grid>

                    <!-- list: one row per session -->
                    <StackPanel x:Name="ListHost" Visibility="Collapsed">
                        <Grid x:Name="ListHeader" Margin="0,0,0,6" />
                        <ItemsControl x:Name="ListRows" Focusable="False" />
                    </StackPanel>

                    <!-- empty -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="0,26" HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyText" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="EmptyButton" Style="{StaticResource SubtleButton}" Margin="0,12,0,0" HorizontalAlignment="Center"
                                Click="EmptyButton_Click" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
        <Button x:Name="MoreRowsButton" Style="{StaticResource SubtleButton}" HorizontalAlignment="Center" Margin="0,4,0,16"
                Visibility="Collapsed" Click="MoreRows_Click" />
    </StackPanel>
</UserControl>
