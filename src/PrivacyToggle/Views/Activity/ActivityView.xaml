<UserControl x:Class="PrivacyToggle.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PrivacyToggle.Views">
    <UserControl.Resources>
        <Style TargetType="ToolTip" BasedOn="{StaticResource ThemedToolTip}" />
    </UserControl.Resources>
    <StackPanel>
        <!-- ============ Header ============ -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource PageTitle}" Text="Activity" Margin="0" />
            <Border x:Name="InfoIcon" Width="18" Height="18" CornerRadius="9" Margin="10,4,0,0" VerticalAlignment="Center"
                    BorderThickness="1.2" BorderBrush="{DynamicResource TextSecondary}" Background="Transparent" Cursor="Help"
                    ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="30000">
                <TextBlock Text="i" FontSize="11" FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                <Border.ToolTip>
                    <ToolTip MaxWidth="340">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Windows only remembers each app's latest use, so PrivacyToggle keeps the full history (7 days) while it runs; time before that shows only each app's last session. An app using a muted microphone still counts as using it. Everything stays on this PC." />
                    </ToolTip>
                </Border.ToolTip>
            </Border>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                   Text="Which apps use your microphone and camera, as recorded by Windows." />

        <!-- ============ Summary tiles ============ -->
        <UniformGrid x:Name="Tiles" Columns="4" Margin="-6,0,-6,14">
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="MicTileGlyph" Focusable="False" />
                        <TextBlock Style="{StaticResource Hint}" Text="Mic time today" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="MicToday" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="CamTileGlyph" Focusable="False" />
                        <TextBlock Style="{StaticResource Hint}" Text="Camera time today" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="CamToday" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Apps used today" />
                    <TextBlock x:Name="AppsToday" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Last access" />
                    <TextBlock x:Name="LastApp" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LastWhen" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ In use now ============ -->
        <DockPanel Margin="2,4,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource LinkButton}" Click="MicPrivacy_Click" ToolTip="Windows Settings → Privacy → Microphone">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="MicLinkGlyph" Focusable="False" />
                        <TextBlock Text="Microphone privacy" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource LinkButton}" Click="CamPrivacy_Click" Margin="6,0,0,0" ToolTip="Windows Settings → Privacy → Camera">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="CamLinkGlyph" Focusable="False" />
                        <TextBlock Text="Camera privacy" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="In use now" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="16,6">
            <StackPanel>
                <ItemsControl x:Name="LiveList" />
                <StackPanel x:Name="LiveEmpty" Orientation="Horizontal" Margin="0,8">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource NoneColor}" VerticalAlignment="Center" Opacity="0.6" />
                    <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" FontSize="13"
                               Text="Nothing is using your microphone or camera right now." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ Toolbar ============ -->
        <Grid Margin="0,6,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Range1h" Style="{StaticResource SegmentSmall}" GroupName="ActRange" Content="1h" Checked="Range_Checked" />
                <RadioButton x:Name="Range6h" Style="{StaticResource SegmentSmall}" GroupName="ActRange" Content="6h" Checked="Range_Checked" />
                <RadioButton x:Name="Range24h" Style="{StaticResource SegmentSmall}" GroupName="ActRange" Content="24h" Checked="Range_Checked" />
                <RadioButton x:Name="Range7d" Style="{StaticResource SegmentSmall}" GroupName="ActRange" Content="7d" Checked="Range_Checked" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="ViewTimeline" Style="{StaticResource SegmentSmall}" GroupName="ActView" Content="Timeline" IsChecked="True" Checked="View_Checked" />
                <RadioButton x:Name="ViewList" Style="{StaticResource SegmentSmall}" GroupName="ActView" Content="List" Margin="0" Checked="View_Checked" />
            </StackPanel>

            <!-- filter chips double as the legend -->
            <WrapPanel Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" GroupName="ActFilter" Content="All" IsChecked="True" Checked="Filter_Checked" />
                <RadioButton x:Name="FilterMic" Style="{StaticResource Chip}" GroupName="ActFilter" Checked="Filter_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="MicChipGlyph" Focusable="False" />
                        <TextBlock Text="Microphone" Margin="5,0,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FilterCam" Style="{StaticResource Chip}" GroupName="ActFilter" Checked="Filter_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="CamChipGlyph" Focusable="False" />
                        <TextBlock Text="Camera" Margin="5,0,0,0" />
                    </StackPanel>
                </RadioButton>
            </WrapPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Hint}" Text="Sort" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="SortBox" Style="{StaticResource Dropdown}" SelectedIndex="0" SelectionChanged="Sort_Changed">
                    <ComboBoxItem Content="Most recent" />
                    <ComboBoxItem Content="Most used" />
                    <ComboBoxItem Content="Name" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ============ Timeline / list ============ -->
        <Border Style="{StaticResource Card}" Padding="8,10,12,10">
            <Grid x:Name="ContentHost">
                <!-- timeline -->
                <Grid x:Name="TimelineHost">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <v:TimeAxis x:Name="Axis" Grid.Column="1" Margin="0,0,0,4" />
                    <v:TimeGrid x:Name="Gridlines" Grid.Row="1" Grid.Column="1" />
                    <ItemsControl x:Name="Rows" Grid.Row="1" Grid.ColumnSpan="2" Focusable="False" />
                    <v:TimeGrid x:Name="NowLine" Grid.Row="1" Grid.Column="1" NowLine="True" />
                </Grid>

                <!-- list -->
                <ItemsControl x:Name="ListRows" Visibility="Collapsed" Focusable="False" />

                <!-- empty -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="0,26" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyText" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="EmptyButton" Style="{StaticResource SubtleButton}" Margin="0,12,0,0" HorizontalAlignment="Center"
                            Click="EmptyButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
