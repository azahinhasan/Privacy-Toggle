<Window x:Class="PrivacyToggle.Views.BlockerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivacyToggle — camera in use" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="24,22,24,20">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="Glyph" Width="40" Height="40" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" Width="350">
                <TextBlock Text="The camera is being held open" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Message" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="Note" Style="{StaticResource Hint}" Margin="0,10,0,0" />
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource SubtleButton}" Content="Cancel" IsCancel="True" MinWidth="90" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="Close it and turn off" IsDefault="True"
                    Margin="10,0,0,0" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
