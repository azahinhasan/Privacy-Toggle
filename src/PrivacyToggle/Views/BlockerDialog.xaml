<Window x:Class="PrivacyToggle.Views.BlockerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivacyToggle — camera in use" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="pack://application:,,,/Assets/app.ico"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Neubrutal card: ink outline, hard shadow, a warning strip you can drag the dialog by. -->
    <Border Margin="4,4,12,12" CornerRadius="10" BorderThickness="3"
            Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Ink}" Effect="{DynamicResource HardShadow}">
        <StackPanel>
            <Border x:Name="DragStrip" Background="{DynamicResource MutedFill}" BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,0,3"
                    CornerRadius="7,7,0,0" Padding="18,10" MouseLeftButtonDown="DragStrip_MouseLeftButtonDown">
                <DockPanel>
                    <Image x:Name="Glyph" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Camera in use" FontFamily="Segoe UI Black, Segoe UI" FontWeight="Black" FontSize="17"
                               Foreground="#111111" Margin="12,0,0,1" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <StackPanel Margin="22,18,22,20">
                <TextBlock Text="The camera is being held open" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="Message" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                <Border Margin="0,14,0,0" Padding="12,8" CornerRadius="6" BorderThickness="2"
                        Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Ink}">
                    <TextBlock x:Name="Note" Style="{StaticResource Hint}" Margin="0" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource SubtleButton}" Content="Cancel" IsCancel="True" MinWidth="96" Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="Close it and turn off" IsDefault="True"
                            Margin="12,0,0,0" Click="Confirm_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
