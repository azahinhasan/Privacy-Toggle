<Window x:Class="PrivacyToggle.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PrivacyToggle.Views"
        Title="PrivacyToggle Settings" Width="720" Height="560" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{DynamicResource SidebarBg}">
            <DockPanel>
                <!-- status card -->
                <Border DockPanel.Dock="Top" Margin="12,14,12,14" Padding="14" CornerRadius="10"
                        Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{DynamicResource LiveColor}" />
                            <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold"
                                       Text="Mic is live" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Hint}" Margin="0,4,0,10" />
                        <Button x:Name="ToggleButton" Style="{StaticResource AccentButton}" Content="Mute"
                                HorizontalAlignment="Stretch" Click="ToggleButton_Click" />
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" x:Name="SidebarVersion" Margin="20,0,0,14"
                           Style="{StaticResource Hint}" />

                <StackPanel>
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="General" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavHotkey" Style="{StaticResource NavItem}" Content="Hotkey" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavFeedback" Style="{StaticResource NavItem}" Content="Feedback" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDevices" Style="{StaticResource NavItem}" Content="Microphones" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="About" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Pages ============ -->
        <Grid Grid.Column="1">

            <!-- General -->
            <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="General" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Startup" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="StartWithWindowsBox" Style="{StaticResource ToggleSwitch}" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed">
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Launch PrivacyToggle in the tray when you sign in." />
                                </StackPanel>
                            </CheckBox>
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="StartMinimizedBox" Style="{StaticResource ToggleSwitch}" Checked="Simple_Changed" Unchecked="Simple_Changed">
                                <StackPanel>
                                    <TextBlock Text="Start minimized to tray" />
                                    <TextBlock Style="{StaticResource Hint}" Text="When off, this window opens every time PrivacyToggle starts manually." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Microphone state when PrivacyToggle starts" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <WrapPanel>
                            <RadioButton x:Name="StartKeepLast" Style="{StaticResource Segment}" GroupName="OnStart" Content="Keep last state" Checked="OnStart_Changed" />
                            <RadioButton x:Name="StartUnmuted" Style="{StaticResource Segment}" GroupName="OnStart" Content="Always unmuted" Checked="OnStart_Changed" />
                            <RadioButton x:Name="StartMuted" Style="{StaticResource Segment}" GroupName="OnStart" Content="Always muted" Checked="OnStart_Changed" />
                        </WrapPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Tray icon" />
                    <Border Style="{StaticResource Card}">
                        <CheckBox x:Name="DoubleClickBox" Style="{StaticResource ToggleSwitch}" Checked="DoubleClick_Changed" Unchecked="DoubleClick_Changed">
                            <StackPanel>
                                <TextBlock Text="Double-click the tray icon to open Settings" />
                                <TextBlock Style="{StaticResource Hint}" Text="Single clicks then wait a moment to tell them apart from double-clicks. Leave off for instant muting." />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Hotkey -->
            <ScrollViewer x:Name="PageHotkey" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Hotkey" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Global shortcut" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <v:HotkeyRecorderBox x:Name="Recorder" Width="260" />
                                <Button Style="{StaticResource SubtleButton}" Content="Reset" Margin="8,0,0,0" Click="ResetHotkey_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Click the box and press a combination. It needs at least one of Ctrl, Alt, Shift or Win plus a key. Works even when another app is focused." />
                            <TextBlock x:Name="HotkeyWarning" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Warning}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Mode" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="ModeToggle" Style="{StaticResource Segment}" GroupName="Mode" Content="Toggle" Checked="Mode_Changed" />
                                <RadioButton x:Name="ModePtt" Style="{StaticResource Segment}" GroupName="Mode" Content="Push-to-talk" Checked="Mode_Changed" />
                            </WrapPanel>
                            <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Feedback -->
            <ScrollViewer x:Name="PageFeedback" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Feedback" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="PlaySoundBox" Style="{StaticResource ToggleSwitch}" Checked="Simple_Changed" Unchecked="Simple_Changed">
                                <StackPanel>
                                    <TextBlock Text="Play a sound on mute / unmute" />
                                    <TextBlock Style="{StaticResource Hint}" Text="A short falling tone when muting, rising when unmuting." />
                                </StackPanel>
                            </CheckBox>
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="NotificationBox" Style="{StaticResource ToggleSwitch}" Checked="Simple_Changed" Unchecked="Simple_Changed">
                                <StackPanel>
                                    <TextBlock Text="Show a Windows notification on toggle" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Not shown for push-to-talk presses." />
                                </StackPanel>
                            </CheckBox>
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="OverlayBox" Style="{StaticResource ToggleSwitch}" Checked="Overlay_Changed" Unchecked="Overlay_Changed">
                                <StackPanel>
                                    <TextBlock Text="Show an on-screen badge while muted" />
                                    <TextBlock Style="{StaticResource Hint}" Text="A small red “MIC OFF” badge that stays on top and lets clicks pass through." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="CornerPanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="Badge position" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="CornerTL" Style="{StaticResource Segment}" GroupName="Corner" Content="Top left" Checked="Overlay_Changed" />
                                    <RadioButton x:Name="CornerTR" Style="{StaticResource Segment}" GroupName="Corner" Content="Top right" Checked="Overlay_Changed" />
                                    <RadioButton x:Name="CornerBL" Style="{StaticResource Segment}" GroupName="Corner" Content="Bottom left" Checked="Overlay_Changed" />
                                    <RadioButton x:Name="CornerBR" Style="{StaticResource Segment}" GroupName="Corner" Content="Bottom right" Checked="Overlay_Changed" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Devices -->
            <ScrollViewer x:Name="PageDevices" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Microphones" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Which microphones to mute" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="DevAll" Style="{StaticResource Segment}" GroupName="Dev" Content="All microphones" Checked="Devices_Changed" />
                                <RadioButton x:Name="DevSelected" Style="{StaticResource Segment}" GroupName="Dev" Content="Only selected" Checked="Devices_Changed" />
                            </WrapPanel>
                            <StackPanel x:Name="DeviceListPanel" Margin="0,12,0,0">
                                <ItemsControl x:Name="DeviceList" />
                                <TextBlock x:Name="NoDevicesText" Style="{StaticResource Hint}" Text="No active microphones found." Visibility="Collapsed" />
                                <TextBlock x:Name="SelectNoneWarning" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Warning}" Visibility="Collapsed"
                                           Text="No microphone selected: muting will have no effect." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <CheckBox x:Name="EnforceBox" Style="{StaticResource ToggleSwitch}" Checked="Enforce_Changed" Unchecked="Enforce_Changed">
                            <StackPanel>
                                <TextBlock Text="Enforce mute" />
                                <TextBlock Style="{StaticResource Hint}" Text="If another app or a headset button unmutes a microphone while PrivacyToggle has it muted, mute it again right away. When off, PrivacyToggle follows the change." />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- About -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="About" />
                    <Border Style="{StaticResource Card}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="AboutIcon" Width="64" Height="64" VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PrivacyToggle" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Quick privacy toggles from the tray or a global hotkey. Microphone control today; camera control is planned." />
                                <TextBlock Margin="0,12,0,0">
                                    <Hyperlink x:Name="RepoLink" NavigateUri="https://github.com/azahinhasan/windows-utility-tools" RequestNavigate="Link_RequestNavigate">
                                        GitHub repository
                                    </Hyperlink>
                                    <Run Text="   ·   " Foreground="{DynamicResource TextSecondary}" />
                                    <Hyperlink Click="OpenSettingsFolder_Click">Open settings folder</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
