<Window x:Class="PrivacyToggle.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PrivacyToggle.Views"
        Title="PrivacyToggle Settings" Width="1080" Height="640" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Neubrutalism: our own title bar (Windows' can't be styled), a thick ink frame around everything. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Frame" BorderBrush="{DynamicResource Ink}" BorderThickness="2.5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Title bar ============ -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,0,2.5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <Path Data="M0,0 H12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.5" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize">
                        <Path x:Name="MaxGlyph" Data="M0.5,0.5 H11.5 V11.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.5" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="Close" Margin="0,0,4,0">
                        <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="BrandIcon" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="PrivacyToggle" FontFamily="Segoe UI Black, Segoe UI" FontWeight="Black" FontSize="15"
                               Foreground="{DynamicResource AccentText}" Margin="10,0,0,1" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Sidebar ============ -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,2.5,0">
            <DockPanel>
                <!-- live status -->
                <Border DockPanel.Dock="Top" Margin="12,16,16,14" Padding="12,10" CornerRadius="8" BorderThickness="2.5"
                        Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Ink}" Effect="{DynamicResource HardShadowSmall}">
                    <StackPanel>
                        <!-- DockPanel (not a horizontal StackPanel) so long status text wraps instead of being cut off -->
                        <DockPanel Margin="0,0,0,7">
                            <Ellipse x:Name="MicDot" DockPanel.Dock="Left" Width="11" Height="11" VerticalAlignment="Top" Margin="0,3,0,0"
                                     Stroke="{DynamicResource Ink}" StrokeThickness="2" />
                            <TextBlock x:Name="MicChip" Margin="9,0,0,0" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,7">
                            <Ellipse x:Name="CamDot" DockPanel.Dock="Left" Width="11" Height="11" VerticalAlignment="Top" Margin="0,3,0,0"
                                     Stroke="{DynamicResource Ink}" StrokeThickness="2" />
                            <TextBlock x:Name="CamChip" Margin="9,0,0,0" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel>
                            <Ellipse x:Name="NetDot" DockPanel.Dock="Left" Width="11" Height="11" VerticalAlignment="Top" Margin="0,3,0,0"
                                     Stroke="{DynamicResource Ink}" StrokeThickness="2" />
                            <TextBlock x:Name="NetChip" Margin="9,0,0,0" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" x:Name="SidebarVersion" Margin="22,0,0,14" Style="{StaticResource Hint}" FontWeight="SemiBold" />

                <StackPanel>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" Content="Overview" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavActivity" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Activity" VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0" Padding="5,0,5,1" CornerRadius="4" VerticalAlignment="Center"
                                    BorderThickness="2" BorderBrush="{DynamicResource Ink}" Background="#C9B6FF">
                                <TextBlock Text="BETA" FontSize="9" FontWeight="Black" Foreground="#111111" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavMic" Style="{StaticResource NavItem}" Content="Microphone" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavCamera" Style="{StaticResource NavItem}" Content="Camera" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavNetwork" Style="{StaticResource NavItem}" Content="Network" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="General" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="About" VerticalAlignment="Center" />
                            <!-- shown when a newer release is out -->
                            <Border x:Name="AboutUpdateBadge" Visibility="Collapsed" Margin="8,0,0,0" Padding="6,0,6,1" CornerRadius="4"
                                    BorderThickness="2" BorderBrush="{DynamicResource Ink}" Background="{DynamicResource LiveFill}">
                                <TextBlock Text="NEW" FontSize="10" FontWeight="Black" Foreground="#111111" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Pages ============ -->
        <Grid Grid.Row="1" Grid.Column="1">

            <!-- Overview -->
            <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Overview" />
                    <!-- Right margin leaves room for the cards' hard shadow; the ScrollViewer clips anything past its edge. -->
                    <Grid Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- microphone card -->
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Image x:Name="MicCardIcon" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Microphone" FontSize="17" FontWeight="Bold" />
                                        <TextBlock x:Name="MicCardDevices" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" x:Name="MicCardButton" Style="{StaticResource AccentButton}"
                                        Margin="0,18,0,0" Click="MicCardButton_Click" />
                                <StackPanel Margin="0,20,0,0">
                                    <Border x:Name="MicStateBadge" HorizontalAlignment="Left" Padding="14,2,14,4" CornerRadius="6" BorderThickness="2.5"
                                            BorderBrush="{DynamicResource Ink}" Effect="{DynamicResource HardShadowSmall}">
                                        <TextBlock x:Name="MicCardState" FontFamily="Segoe UI Black, Segoe UI" FontSize="24" FontWeight="Black" Foreground="#111111" />
                                    </Border>
                                    <TextBlock x:Name="MicCardHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- camera card -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" Margin="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Image x:Name="CamCardIcon" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Camera" FontSize="17" FontWeight="Bold" />
                                        <TextBlock x:Name="CamCardDevices" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" x:Name="CamCardButton" Style="{StaticResource AccentButton}"
                                        Margin="0,18,0,0" Click="CamCardButton_Click" />
                                <StackPanel Margin="0,20,0,0">
                                    <Border x:Name="CamStateBadge" HorizontalAlignment="Left" Padding="14,2,14,4" CornerRadius="6" BorderThickness="2.5"
                                            BorderBrush="{DynamicResource Ink}" Effect="{DynamicResource HardShadowSmall}">
                                        <TextBlock x:Name="CamCardState" FontFamily="Segoe UI Black, Segoe UI" FontSize="24" FontWeight="Black" Foreground="#111111" />
                                    </Border>
                                    <TextBlock x:Name="CamCardHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- network card (second row: three cards side by side get too narrow) -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,22,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Image x:Name="NetCardIcon" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Network" FontSize="17" FontWeight="Bold" />
                                        <TextBlock x:Name="NetCardDevices" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" x:Name="NetCardButton" Style="{StaticResource AccentButton}"
                                        Margin="0,18,0,0" Click="NetCardButton_Click" />
                                <StackPanel Margin="0,20,0,0">
                                    <Border x:Name="NetStateBadge" HorizontalAlignment="Left" Padding="14,2,14,4" CornerRadius="6" BorderThickness="2.5"
                                            BorderBrush="{DynamicResource Ink}" Effect="{DynamicResource HardShadowSmall}">
                                        <TextBlock x:Name="NetCardState" FontFamily="Segoe UI Black, Segoe UI" FontSize="24" FontWeight="Black" Foreground="#111111" />
                                    </Border>
                                    <TextBlock x:Name="NetCardHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="2,16,0,0"
                               Text="Click a tray icon or press its shortcut to switch. Right-click a tray icon for more options." />
                </StackPanel>
            </ScrollViewer>

            <!-- Activity -->
            <ScrollViewer x:Name="PageActivity" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <v:ActivityView x:Name="ActivityPage" />
            </ScrollViewer>

            <!-- Microphone -->
            <ScrollViewer x:Name="PageMic" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Microphone" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Shortcut" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <v:HotkeyRecorderBox x:Name="Recorder" Width="260" />
                                <Button Style="{StaticResource SubtleButton}" Content="Reset" Margin="8,0,0,0" Click="ResetHotkey_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Click the box and press a combination with at least one of Ctrl, Alt, Shift or Win. Works even when another app is focused." />
                            <TextBlock x:Name="HotkeyWarning" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Warning}" Visibility="Collapsed" />
                            <WrapPanel Margin="0,14,0,0">
                                <RadioButton x:Name="ModeToggle" Style="{StaticResource Segment}" GroupName="Mode" Content="Toggle" Checked="Mode_Changed" />
                                <RadioButton x:Name="ModePtt" Style="{StaticResource Segment}" GroupName="Mode" Content="Push-to-talk" Checked="Mode_Changed" />
                            </WrapPanel>
                            <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="When PrivacyToggle starts" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <WrapPanel>
                            <RadioButton x:Name="StartKeepLast" Style="{StaticResource Segment}" GroupName="OnStart" Content="Keep last state" Checked="OnStart_Changed" />
                            <RadioButton x:Name="StartUnmuted" Style="{StaticResource Segment}" GroupName="OnStart" Content="Always unmuted" Checked="OnStart_Changed" />
                            <RadioButton x:Name="StartMuted" Style="{StaticResource Segment}" GroupName="OnStart" Content="Always muted" Checked="OnStart_Changed" />
                        </WrapPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Which microphones to mute" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="DevAll" Style="{StaticResource Segment}" GroupName="Dev" Content="All microphones" Checked="Devices_Changed" />
                                <RadioButton x:Name="DevSelected" Style="{StaticResource Segment}" GroupName="Dev" Content="Only selected" Checked="Devices_Changed" />
                            </WrapPanel>
                            <StackPanel x:Name="DeviceListPanel" Margin="0,12,0,0">
                                <ItemsControl x:Name="DeviceList" />
                                <TextBlock x:Name="NoDevicesText" Style="{StaticResource Hint}" Text="No active microphones found." Visibility="Collapsed" />
                                <TextBlock x:Name="SelectNoneWarning" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Warning}" Visibility="Collapsed"
                                           Text="No microphone selected: muting will have no effect." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <CheckBox x:Name="EnforceBox" Style="{StaticResource ToggleSwitch}" Checked="Enforce_Changed" Unchecked="Enforce_Changed">
                            <StackPanel>
                                <TextBlock Text="Enforce mute" />
                                <TextBlock Style="{StaticResource Hint}" Text="If another app or a headset button unmutes a microphone while PrivacyToggle has it muted, mute it again right away. When off, PrivacyToggle follows the change." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Tray icon" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="MicTrayBox" Style="{StaticResource ToggleSwitch}" Checked="MicTray_Changed" Unchecked="MicTray_Changed">
                                <StackPanel>
                                    <TextBlock Text="Show the microphone icon in the tray" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Click it to mute or unmute. Right-click for both controls and Settings." />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock x:Name="MicNoTrayWarning" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Visibility="Collapsed" Text="With both tray icons hidden, use the shortcuts, or start PrivacyToggle again to open this window." />
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="DoubleClickBox" Style="{StaticResource ToggleSwitch}" Checked="DoubleClick_Changed" Unchecked="DoubleClick_Changed">
                                <StackPanel>
                                    <TextBlock Text="Double-click the icon to open Settings" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Single clicks stay instant; a double-click undoes that click." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Alerts" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="MicNotifyBox" Style="{StaticResource ToggleSwitch}" Checked="Alerts_Changed" Unchecked="Alerts_Changed">
                                <StackPanel>
                                    <TextBlock Text="Notify me when the microphone mutes or unmutes" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Each time you switch it, as a Windows notification or a badge that disappears after 2 seconds. Not shown for push-to-talk presses." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="MicNotifyStylePanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="Notification style" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="MicNotifyWindows" Style="{StaticResource Segment}" GroupName="MicNotifyStyle" Content="Windows notification" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="MicNotifyBadge" Style="{StaticResource Segment}" GroupName="MicNotifyStyle" Content="Corner badge" Checked="Alerts_Changed" />
                                </WrapPanel>
                                <StackPanel x:Name="MicNotifyCornerPanel" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Hint}" Text="Badge position" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <RadioButton x:Name="MicNotifyCornerTL" Style="{StaticResource Segment}" GroupName="MicNotifyCorner" Content="Top left" Checked="Alerts_Changed" />
                                        <RadioButton x:Name="MicNotifyCornerTR" Style="{StaticResource Segment}" GroupName="MicNotifyCorner" Content="Top right" Checked="Alerts_Changed" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="MicOverlayBox" Style="{StaticResource ToggleSwitch}" Checked="Alerts_Changed" Unchecked="Alerts_Changed">
                                <StackPanel>
                                    <TextBlock Text="Show a MIC OFF badge while muted" />
                                    <TextBlock Style="{StaticResource Hint}" Text="A small badge that stays on top of every app and lets clicks pass through." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="MicCornerPanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="Badge position" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="MicCornerTL" Style="{StaticResource Segment}" GroupName="MicCorner" Content="Top left" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="MicCornerTR" Style="{StaticResource Segment}" GroupName="MicCorner" Content="Top right" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="MicCornerBL" Style="{StaticResource Segment}" GroupName="MicCorner" Content="Bottom left" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="MicCornerBR" Style="{StaticResource Segment}" GroupName="MicCorner" Content="Bottom right" Checked="Alerts_Changed" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>                </StackPanel>
            </ScrollViewer>

            <!-- Camera -->
            <ScrollViewer x:Name="PageCamera" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Camera" />

                    <Border x:Name="CamHelperBanner" Style="{StaticResource Card}" Padding="16,14" BorderBrush="{DynamicResource Warning}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Camera control isn't installed" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="Turning cameras off needs the PrivacyToggle helper service, which the installer sets up (it asks for admin rights once). Run PrivacyToggle-Setup to enable it." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Shortcut" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <v:HotkeyRecorderBox x:Name="CamRecorder" Width="260" />
                                <Button Style="{StaticResource SubtleButton}" Content="Reset" Margin="8,0,0,0" Click="ResetCamHotkey_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Click the box and press a combination with at least one of Ctrl, Alt, Shift or Win. Works even when another app is focused." />
                            <TextBlock x:Name="CamHotkeyWarning" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Warning}" Visibility="Collapsed" />
                            <TextBlock x:Name="CamHotkeyHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="When PrivacyToggle starts" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <WrapPanel>
                            <RadioButton x:Name="CamStartKeepLast" Style="{StaticResource Segment}" GroupName="CamOnStart" Content="Keep last state" Checked="CamOnStart_Changed" />
                            <RadioButton x:Name="CamStartOn" Style="{StaticResource Segment}" GroupName="CamOnStart" Content="Always on" Checked="CamOnStart_Changed" />
                            <RadioButton x:Name="CamStartOff" Style="{StaticResource Segment}" GroupName="CamOnStart" Content="Always off" Checked="CamOnStart_Changed" />
                        </WrapPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Which cameras to turn off" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="CamDevAll" Style="{StaticResource Segment}" GroupName="CamDev" Content="All cameras" Checked="CamDevices_Changed" />
                                <RadioButton x:Name="CamDevSelected" Style="{StaticResource Segment}" GroupName="CamDev" Content="Only selected" Checked="CamDevices_Changed" />
                            </WrapPanel>
                            <StackPanel x:Name="CamListPanel" Margin="0,12,0,0">
                                <ItemsControl x:Name="CamList" />
                                <TextBlock x:Name="NoCamerasText" Style="{StaticResource Hint}" Text="No cameras found." Visibility="Collapsed" />
                                <TextBlock x:Name="CamSelectNoneWarning" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Warning}" Visibility="Collapsed"
                                           Text="No camera selected: turning off will have no effect." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="CamEnforceBox" Style="{StaticResource ToggleSwitch}" Checked="CamEnforce_Changed" Unchecked="CamEnforce_Changed">
                                <StackPanel>
                                    <TextBlock Text="Keep cameras off" />
                                    <TextBlock Style="{StaticResource Hint}" Text="If a camera is turned back on elsewhere (for example in Device Manager) while PrivacyToggle has it off, turn it off again. When off, PrivacyToggle follows the change." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Tray icon" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="CamTrayBox" Style="{StaticResource ToggleSwitch}" Checked="CamTray_Changed" Unchecked="CamTray_Changed">
                                <StackPanel>
                                    <TextBlock Text="Show the camera icon in the tray" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Click it to turn the camera off or on. Right-click for both controls and Settings." />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock x:Name="CamNoTrayWarning" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Visibility="Collapsed" Text="With both tray icons hidden, use the shortcuts, or start PrivacyToggle again to open this window." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Alerts" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="CamNotifyBox" Style="{StaticResource ToggleSwitch}" Checked="Alerts_Changed" Unchecked="Alerts_Changed">
                                <StackPanel>
                                    <TextBlock Text="Notify me when the camera turns off or on" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Each time you switch it, as a Windows notification or a badge that disappears after 2 seconds." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="CamNotifyStylePanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="Notification style" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="CamNotifyWindows" Style="{StaticResource Segment}" GroupName="CamNotifyStyle" Content="Windows notification" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="CamNotifyBadge" Style="{StaticResource Segment}" GroupName="CamNotifyStyle" Content="Corner badge" Checked="Alerts_Changed" />
                                </WrapPanel>
                                <StackPanel x:Name="CamNotifyCornerPanel" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Hint}" Text="Badge position" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <RadioButton x:Name="CamNotifyCornerTL" Style="{StaticResource Segment}" GroupName="CamNotifyCorner" Content="Top left" Checked="Alerts_Changed" />
                                        <RadioButton x:Name="CamNotifyCornerTR" Style="{StaticResource Segment}" GroupName="CamNotifyCorner" Content="Top right" Checked="Alerts_Changed" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="CamOverlayBox" Style="{StaticResource ToggleSwitch}" Checked="Alerts_Changed" Unchecked="Alerts_Changed">
                                <StackPanel>
                                    <TextBlock Text="Show a CAM OFF badge while off" />
                                    <TextBlock Style="{StaticResource Hint}" Text="A small badge that stays on top of every app and lets clicks pass through. If it shares a corner with the MIC OFF badge, they sit side by side." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="CamCornerPanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="Badge position" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="CamCornerTL" Style="{StaticResource Segment}" GroupName="CamCorner" Content="Top left" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="CamCornerTR" Style="{StaticResource Segment}" GroupName="CamCorner" Content="Top right" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="CamCornerBL" Style="{StaticResource Segment}" GroupName="CamCorner" Content="Bottom left" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="CamCornerBR" Style="{StaticResource Segment}" GroupName="CamCorner" Content="Bottom right" Checked="Alerts_Changed" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,12"
                               Text="Turning the camera off disables it in Windows, the same as Device Manager does. Apps using it lose the picture immediately, and no app can open it until you turn it back on. If a program holds the camera and won't let go, PrivacyToggle asks before closing it; a background service closed this way is started again when you turn the camera back on." />
                </StackPanel>
            </ScrollViewer>

            <!-- Network -->
            <ScrollViewer x:Name="PageNetwork" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Network" />

                    <Border x:Name="NetHelperBanner" Style="{StaticResource Card}" Padding="16,14" BorderBrush="{DynamicResource Warning}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="NetHelperBannerTitle" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" />
                            <TextBlock x:Name="NetHelperBannerText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Shortcut" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <v:HotkeyRecorderBox x:Name="NetRecorder" Width="260" />
                                <Button Style="{StaticResource SubtleButton}" Content="Reset" Margin="8,0,0,0" Click="ResetNetHotkey_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Click the box and press a combination with at least one of Ctrl, Alt, Shift or Win. Works even when another app is focused." />
                            <TextBlock x:Name="NetHotkeyWarning" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Warning}" Visibility="Collapsed" />
                            <TextBlock x:Name="NetHotkeyHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="When PrivacyToggle starts" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <WrapPanel>
                            <RadioButton x:Name="NetStartKeepLast" Style="{StaticResource Segment}" GroupName="NetOnStart" Content="Keep last state" Checked="NetOnStart_Changed" />
                            <RadioButton x:Name="NetStartOn" Style="{StaticResource Segment}" GroupName="NetOnStart" Content="Always connected" Checked="NetOnStart_Changed" />
                            <RadioButton x:Name="NetStartOff" Style="{StaticResource Segment}" GroupName="NetOnStart" Content="Always disconnected" Checked="NetOnStart_Changed" />
                        </WrapPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Which connections to turn off" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="NetDevAll" Style="{StaticResource Segment}" GroupName="NetDev" Content="All (Wi-Fi and wired)" Checked="NetDevices_Changed" />
                                <RadioButton x:Name="NetDevSelected" Style="{StaticResource Segment}" GroupName="NetDev" Content="Only selected" Checked="NetDevices_Changed" />
                            </WrapPanel>
                            <StackPanel x:Name="NetListPanel" Margin="0,12,0,0">
                                <ItemsControl x:Name="NetList" />
                                <TextBlock x:Name="NoAdaptersText" Style="{StaticResource Hint}" Text="No network adapters found." Visibility="Collapsed" />
                                <TextBlock x:Name="NetSelectNoneWarning" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Warning}" Visibility="Collapsed"
                                           Text="No connection selected: turning the network off will have no effect." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="NetEnforceBox" Style="{StaticResource ToggleSwitch}" Checked="NetEnforce_Changed" Unchecked="NetEnforce_Changed">
                                <StackPanel>
                                    <TextBlock Text="Keep the network off" />
                                    <TextBlock Style="{StaticResource Hint}" Text="If a connection is turned back on elsewhere (for example in Network Connections) while PrivacyToggle has it off, turn it off again. When off, PrivacyToggle follows the change." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Tray icon" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="NetTrayBox" Style="{StaticResource ToggleSwitch}" Checked="NetTray_Changed" Unchecked="NetTray_Changed">
                                <StackPanel>
                                    <TextBlock Text="Show the network icon in the tray" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Click it to disconnect or reconnect. Right-click for all controls and Settings." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TaskbarSpeedSection" Style="{StaticResource SectionTitle}" Text="Taskbar speed" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="TaskbarSpeedBox" Style="{StaticResource ToggleSwitch}" Checked="TaskbarSpeed_Changed" Unchecked="TaskbarSpeed_Changed">
                                <StackPanel>
                                    <TextBlock Text="Show network speed on the taskbar" />
                                    <TextBlock Style="{StaticResource Hint}" Text="The current download and upload speed of this PC, next to the tray icons. Updates every second, and steps aside for fullscreen apps." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="TaskbarSpeedShowPanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="Show" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="TaskbarShowBoth" Style="{StaticResource Segment}" GroupName="TaskbarShow" Content="Download and upload" Checked="TaskbarSpeed_Changed" />
                                    <RadioButton x:Name="TaskbarShowDown" Style="{StaticResource Segment}" GroupName="TaskbarShow" Content="Download only" Checked="TaskbarSpeed_Changed" />
                                    <RadioButton x:Name="TaskbarShowUp" Style="{StaticResource Segment}" GroupName="TaskbarShow" Content="Upload only" Checked="TaskbarSpeed_Changed" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Alerts" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="NetNotifyBox" Style="{StaticResource ToggleSwitch}" Checked="Alerts_Changed" Unchecked="Alerts_Changed">
                                <StackPanel>
                                    <TextBlock Text="Notify me when the network turns off or on" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Each time you switch it, as a Windows notification or a badge that disappears after 2 seconds." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="NetNotifyStylePanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="Notification style" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="NetNotifyWindows" Style="{StaticResource Segment}" GroupName="NetNotifyStyle" Content="Windows notification" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="NetNotifyBadge" Style="{StaticResource Segment}" GroupName="NetNotifyStyle" Content="Corner badge" Checked="Alerts_Changed" />
                                </WrapPanel>
                                <StackPanel x:Name="NetNotifyCornerPanel" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Hint}" Text="Badge position" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <RadioButton x:Name="NetNotifyCornerTL" Style="{StaticResource Segment}" GroupName="NetNotifyCorner" Content="Top left" Checked="Alerts_Changed" />
                                        <RadioButton x:Name="NetNotifyCornerTR" Style="{StaticResource Segment}" GroupName="NetNotifyCorner" Content="Top right" Checked="Alerts_Changed" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="NetOverlayBox" Style="{StaticResource ToggleSwitch}" Checked="Alerts_Changed" Unchecked="Alerts_Changed">
                                <StackPanel>
                                    <TextBlock Text="Show a NET OFF badge while off" />
                                    <TextBlock Style="{StaticResource Hint}" Text="A small badge that stays on top of every app and lets clicks pass through. If it shares a corner with another OFF badge, they sit side by side." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="NetCornerPanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="Badge position" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="NetCornerTL" Style="{StaticResource Segment}" GroupName="NetCorner" Content="Top left" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="NetCornerTR" Style="{StaticResource Segment}" GroupName="NetCorner" Content="Top right" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="NetCornerBL" Style="{StaticResource Segment}" GroupName="NetCorner" Content="Bottom left" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="NetCornerBR" Style="{StaticResource Segment}" GroupName="NetCorner" Content="Bottom right" Checked="Alerts_Changed" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,12"
                               Text="Turning the network off disables the selected network adapters in Windows, the same as the Network Connections window does. Nothing on this PC can reach the internet or your local network through them until you turn them back on. Virtual adapters (VPNs, virtual machines, WSL) aren't touched. Uninstalling PrivacyToggle turns every adapter it switched off back on." />
                </StackPanel>
            </ScrollViewer>

            <!-- General -->
            <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="General" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Startup" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="StartWithWindowsBox" Style="{StaticResource ToggleSwitch}" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed">
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Launch PrivacyToggle in the tray when you sign in." />
                                </StackPanel>
                            </CheckBox>
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="StartMinimizedBox" Style="{StaticResource ToggleSwitch}" Checked="Simple_Changed" Unchecked="Simple_Changed">
                                <StackPanel>
                                    <TextBlock Text="Start minimized to tray" />
                                    <TextBlock Style="{StaticResource Hint}" Text="When off, this window opens every time PrivacyToggle starts manually." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="Theme" Content="Match Windows" Checked="Theme_Changed" />
                                <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="Theme" Content="Light" Checked="Theme_Changed" />
                                <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="Theme" Content="Dark" Checked="Theme_Changed" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Light is the classic look: cream paper, black ink and bold colours." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Sound" />
                    <Border Style="{StaticResource Card}">
                        <CheckBox x:Name="PlaySoundBox" Style="{StaticResource ToggleSwitch}" Checked="Simple_Changed" Unchecked="Simple_Changed">
                            <StackPanel>
                                <TextBlock Text="Play a sound when switching" />
                                <TextBlock Style="{StaticResource Hint}" Text="A short tone when the microphone or camera turns on or off (the camera has its own, lower tone). Turn off for silent switching." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- About -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="About" />
                    <Border Style="{StaticResource Card}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="AboutIcon" Width="64" Height="64" VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PrivacyToggle" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Quick privacy toggles for your microphone and camera, from the tray or a global shortcut." />
                                <TextBlock x:Name="HelperStatusText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                <TextBlock Margin="0,12,0,0">
                                    <Hyperlink x:Name="RepoLink" NavigateUri="https://github.com/azahinhasan/Privacy-Toggle" RequestNavigate="Link_RequestNavigate">
                                        GitHub repository
                                    </Hyperlink>
                                    <Run Text="   ·   " Foreground="{DynamicResource TextSecondary}" />
                                    <Hyperlink Click="OpenSettingsFolder_Click">Open settings folder</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Updates" />
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button x:Name="CheckUpdatesButton" Style="{StaticResource SubtleButton}" Content="Check again" Click="CheckUpdates_Click" />
                                    <Button x:Name="UpdateButton" Style="{StaticResource AccentButton}" Content="Update now" Margin="12,0,4,4"
                                            Visibility="Collapsed" Click="UpdateNow_Click" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateStatus" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Text="Checking for updates…" />
                                    <TextBlock x:Name="UpdateDetail" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="UpdateProgress" Style="{StaticResource BrutalProgress}" Margin="0,14,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="ReleaseLinkText" Margin="0,10,0,0" Visibility="Collapsed">
                                <Hyperlink x:Name="ReleaseLink" RequestNavigate="Link_RequestNavigate" NavigateUri="https://github.com/azahinhasan/Privacy-Toggle/releases">
                                    <Run x:Name="ReleaseLinkRun" Text="What's new" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    </Border>
</Window>
