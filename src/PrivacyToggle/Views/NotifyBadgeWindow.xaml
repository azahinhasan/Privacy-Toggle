<Window x:Class="PrivacyToggle.Views.NotifyBadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivacyToggle notification" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" IsHitTestVisible="False" Opacity="0">
    <!-- Same neubrutal look as the MIC OFF / CAM OFF badges; the colour follows the new state. -->
    <Border x:Name="Badge" CornerRadius="8" Background="#FF6B6B" BorderBrush="#111111" BorderThickness="2.5"
            Padding="9,5,12,5" Margin="4,4,10,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="0" ShadowDepth="4" Direction="315" Color="#111111" Opacity="1" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Canvas x:Name="MicIcon">
                        <Path Fill="#111111" Data="M9,3 a3,3 0 0 1 6,0 v8 a3,3 0 0 1 -6,0 z" Canvas.Top="1" />
                        <Path Stroke="#111111" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M5,11 a7,7 0 0 0 14,0 M12,18 v3 M8.5,21.5 h7" />
                    </Canvas>
                    <Canvas x:Name="CamIcon">
                        <Rectangle Fill="#111111" Width="13" Height="11" RadiusX="2.5" RadiusY="2.5" Canvas.Left="2" Canvas.Top="6.5" />
                        <Path Fill="#111111" Data="M16,10.5 L22,7 V17 L16,13.5 Z" />
                    </Canvas>
                    <Canvas x:Name="Slash">
                        <Path x:Name="SlashGap" Stroke="#FF6B6B" StrokeThickness="5" Data="M4,4 L20,20" />
                        <Path Stroke="#111111" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,4 L20,20" />
                    </Canvas>
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="Label" Text="MIC OFF" Foreground="#111111" FontFamily="Segoe UI Black, Segoe UI" FontWeight="Black" FontSize="13"
                       Margin="7,0,0,1" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
