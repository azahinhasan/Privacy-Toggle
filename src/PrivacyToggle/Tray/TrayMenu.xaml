<!--
    Tray right-click menu. It always uses the light look (it pops up over the taskbar, outside the
    Settings window, so it doesn't follow the app's Appearance setting) and is kept compact.
    All its styles live here, so nothing from the dark/light theme files reaches it.
-->
<ContextMenu x:Class="PrivacyToggle.Tray.TrayMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="12" Foreground="#111111" HasDropShadow="False">
    <ContextMenu.Resources>
        <!-- fixed light palette -->
        <SolidColorBrush x:Key="MenuBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MenuInk" Color="#111111" />
        <SolidColorBrush x:Key="MenuHighlight" Color="#D97A2B" />

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Padding="6,4,10,4" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="Transparent" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Check" Data="M 1,5 L 4,8 L 9,2" Stroke="#111111" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="Hidden" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHighlight}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MenuInk}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1.5" Margin="4,3" Background="{StaticResource MenuInk}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContextMenu.Resources>

    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <!-- right/bottom margin leaves room for the small hard shadow -->
            <Border Margin="0,0,4,4" Padding="3" MinWidth="168" CornerRadius="6" BorderThickness="2"
                    Background="{StaticResource MenuBg}" BorderBrush="{StaticResource MenuInk}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="3" Direction="315" Color="#111111" Opacity="1" />
                </Border.Effect>
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>

    <MenuItem x:Name="ToggleItem" Header="Mute microphone" Click="Toggle_Click" />
    <MenuItem x:Name="CameraItem" Header="Turn camera off" Click="Camera_Click" />
    <MenuItem x:Name="NetworkItem" Header="Disconnect network" Click="Network_Click" />
    <Separator />
    <MenuItem Header="Settings…" Click="Settings_Click" />
    <MenuItem x:Name="StartupItem" Header="Start with Windows" IsCheckable="True" Click="Startup_Click" />
    <Separator />
    <MenuItem Header="Exit" Click="Exit_Click" />
</ContextMenu>
