<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neubrutalism, dark: charcoal paper; outlines and hard shadows in cream (black would vanish), same bold colours. -->

    <!-- ink: outlines, hard shadows -->
    <Color x:Key="InkColor">#F4EEDC</Color>
    <SolidColorBrush x:Key="Ink" Color="#F4EEDC" />
    <DropShadowEffect x:Key="HardShadow" BlurRadius="0" ShadowDepth="5" Direction="315" Color="#F4EEDC" Opacity="1" />
    <DropShadowEffect x:Key="HardShadowSmall" BlurRadius="0" ShadowDepth="3" Direction="315" Color="#F4EEDC" Opacity="1" />

    <!-- surfaces -->
    <SolidColorBrush x:Key="WindowBg" Color="#1B1A18" />
    <SolidColorBrush x:Key="SidebarBg" Color="#22302A" />
    <SolidColorBrush x:Key="CardBg" Color="#2A2926" />
    <SolidColorBrush x:Key="CardBorder" Color="#F4EEDC" />
    <SolidColorBrush x:Key="Divider" Color="#F4EEDC" />
    <SolidColorBrush x:Key="ControlBg" Color="#2A2926" />
    <SolidColorBrush x:Key="ControlBorder" Color="#F4EEDC" />
    <SolidColorBrush x:Key="DetailBg" Color="#33322E" />

    <!-- text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F4EEDC" />
    <SolidColorBrush x:Key="TextSecondary" Color="#BDB7A6" />

    <!-- accent: burnt orange with black text -->
    <SolidColorBrush x:Key="Accent" Color="#D97A2B" />
    <SolidColorBrush x:Key="AccentHover" Color="#C4691D" />
    <SolidColorBrush x:Key="AccentText" Color="#111111" />
    <SolidColorBrush x:Key="Accent2" Color="#FF8FD8" />

    <!-- interaction -->
    <SolidColorBrush x:Key="HoverBg" Color="#3A3830" />
    <SolidColorBrush x:Key="SelectedBg" Color="#D97A2B" />
    <SolidColorBrush x:Key="ChipSelectedBg" Color="#D97A2B" />
    <SolidColorBrush x:Key="RowHoverBg" Color="#36342D" />
    <SolidColorBrush x:Key="ToggleOffBg" Color="#2A2926" />
    <SolidColorBrush x:Key="ToggleOffBorder" Color="#F4EEDC" />
    <SolidColorBrush x:Key="ToggleOffThumb" Color="#F4EEDC" />
    <SolidColorBrush x:Key="ToggleOnBg" Color="#7BE495" />

    <!-- status -->
    <SolidColorBrush x:Key="Warning" Color="#FFA94D" />
    <SolidColorBrush x:Key="WarningBg" Color="#3D2B1A" />
    <SolidColorBrush x:Key="LiveColor" Color="#69DB7C" />
    <SolidColorBrush x:Key="MutedColor" Color="#FF6B6B" />
    <SolidColorBrush x:Key="NoneColor" Color="#9AA0A6" />
    <SolidColorBrush x:Key="LiveFill" Color="#7BE495" />
    <SolidColorBrush x:Key="MutedFill" Color="#FF8A8A" />
    <SolidColorBrush x:Key="NoneFill" Color="#5A5A55" />

    <!-- devices (Activity) -->
    <SolidColorBrush x:Key="CamUsage" Color="#FF7AC6" />
    <SolidColorBrush x:Key="MicUsage" Color="#6EA8FF" />
    <SolidColorBrush x:Key="BadgeText" Color="#111111" />
</ResourceDictionary>
