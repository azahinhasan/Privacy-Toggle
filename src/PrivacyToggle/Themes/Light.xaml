<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neubrutalism, light: cream paper, black ink outlines and hard shadows, flat bold colours. -->

    <!-- ink: outlines, hard shadows, text on colour -->
    <Color x:Key="InkColor">#111111</Color>
    <SolidColorBrush x:Key="Ink" Color="#111111" />
    <DropShadowEffect x:Key="HardShadow" BlurRadius="0" ShadowDepth="5" Direction="315" Color="#111111" Opacity="1" />
    <DropShadowEffect x:Key="HardShadowSmall" BlurRadius="0" ShadowDepth="3" Direction="315" Color="#111111" Opacity="1" />

    <!-- surfaces -->
    <SolidColorBrush x:Key="WindowBg" Color="#FFF6E0" />
    <SolidColorBrush x:Key="SidebarBg" Color="#B8F0D8" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#111111" />
    <SolidColorBrush x:Key="Divider" Color="#111111" />
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorder" Color="#111111" />
    <SolidColorBrush x:Key="DetailBg" Color="#FFF6EC" />

    <!-- text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#111111" />
    <SolidColorBrush x:Key="TextSecondary" Color="#4A4A4A" />

    <!-- accent: burnt orange with black text -->
    <SolidColorBrush x:Key="Accent" Color="#D97A2B" />
    <SolidColorBrush x:Key="AccentHover" Color="#C4691D" />
    <SolidColorBrush x:Key="AccentText" Color="#111111" />
    <SolidColorBrush x:Key="Accent2" Color="#FF8FD8" />

    <!-- interaction -->
    <SolidColorBrush x:Key="HoverBg" Color="#F8DEC6" />
    <SolidColorBrush x:Key="SelectedBg" Color="#D97A2B" />
    <SolidColorBrush x:Key="ChipSelectedBg" Color="#D97A2B" />
    <SolidColorBrush x:Key="RowHoverBg" Color="#FBE9D8" />
    <SolidColorBrush x:Key="ToggleOffBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleOffBorder" Color="#111111" />
    <SolidColorBrush x:Key="ToggleOffThumb" Color="#111111" />
    <SolidColorBrush x:Key="ToggleOnBg" Color="#7BE495" />

    <!-- status -->
    <SolidColorBrush x:Key="Warning" Color="#D9480F" />
    <SolidColorBrush x:Key="WarningBg" Color="#FFE3CC" />
    <SolidColorBrush x:Key="LiveColor" Color="#22B04B" />
    <SolidColorBrush x:Key="MutedColor" Color="#F03E3E" />
    <SolidColorBrush x:Key="NoneColor" Color="#9AA0A6" />
    <SolidColorBrush x:Key="LiveFill" Color="#7BE495" />
    <SolidColorBrush x:Key="MutedFill" Color="#FF8A8A" />
    <SolidColorBrush x:Key="NoneFill" Color="#DADDE1" />

    <!-- devices (Activity): fill, and text placed on that fill -->
    <SolidColorBrush x:Key="CamUsage" Color="#E84DA8" />
    <SolidColorBrush x:Key="MicUsage" Color="#4D96FF" />
    <SolidColorBrush x:Key="NetUsage" Color="#2BB894" />
    <SolidColorBrush x:Key="CamOnText" Color="#3D1028" />
    <SolidColorBrush x:Key="MicOnText" Color="#10203D" />
    <SolidColorBrush x:Key="NetOnText" Color="#0F2A21" />
    <SolidColorBrush x:Key="BadgeText" Color="#111111" />

    <!-- Activity page: download = network teal, upload = orange (darker shades than dark mode, for contrast on cream) -->
    <SolidColorBrush x:Key="DownloadText" Color="#0E7F63" />
    <SolidColorBrush x:Key="UploadText" Color="#B35A12" />
    <SolidColorBrush x:Key="AccentSoft" Color="#B35A12" />
    <SolidColorBrush x:Key="PanelBg" Color="#FFFDF8" />
    <SolidColorBrush x:Key="TrackBg" Color="#EFE7D8" />
    <SolidColorBrush x:Key="LiveZoneBg" Color="#FCEEDC" />
    <SolidColorBrush x:Key="IdleBorder" Color="#B9B0A2" />
    <SolidColorBrush x:Key="SectionDivider" Color="#D9CFBF" />
    <SolidColorBrush x:Key="RowLine" Color="#ECE4D6" />
    <SolidColorBrush x:Key="PillOffBg" Color="#E8E1D5" />
    <SolidColorBrush x:Key="PillOffText" Color="#4A4A4A" />
    <SolidColorBrush x:Key="StatusOn" Color="#22B04B" />
    <SolidColorBrush x:Key="StatusOff" Color="#F03E3E" />
</ResourceDictionary>
