<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Neubrutalism: thick ink outlines, hard (unblurred) offset shadows, flat bold colours, chunky type.
        Pressable things sit on an ink "shadow" block and slide onto it when pressed.
        Colours come from Light.xaml / Dark.xaml (Ink, Accent, CardBg, ...).
    -->

    <!-- ================= Text ================= -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Black, Segoe UI" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="2,6,0,10" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- ================= Card ================= -->
    <!-- Right/bottom margin leaves room for the hard shadow. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
        <Setter Property="BorderThickness" Value="2.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="Margin" Value="0,0,6,22" />
        <Setter Property="Effect" Value="{DynamicResource HardShadow}" />
    </Style>
    <Style x:Key="RowDivider" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Margin" Value="-16,0" />
        <Setter Property="Background" Value="{DynamicResource Ink}" />
    </Style>

    <!-- ================= Toggle switch (CheckBox) ================= -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Grid Grid.Column="1" Width="50" Height="26" VerticalAlignment="Center">
                            <Border CornerRadius="13" Background="{DynamicResource Ink}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="3" Y="3" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="Track" CornerRadius="13" BorderThickness="2.5"
                                    Background="{DynamicResource ToggleOffBg}" BorderBrush="{DynamicResource Ink}">
                                <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7" HorizontalAlignment="Left" Margin="4,0,0,0"
                                        Background="{DynamicResource Ink}" />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleOnBg}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="Thumb" Property="Background" Value="#111111" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="16" />
                            <Setter TargetName="Thumb" Property="Height" Value="16" />
                            <Setter TargetName="Thumb" Property="CornerRadius" Value="8" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderThickness" Value="3.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Check item (device lists) ================= -->
    <Style x:Key="CheckItem" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="22" Height="22">
                            <Border CornerRadius="4" Background="{DynamicResource Ink}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="2" Y="2" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="Box" CornerRadius="4" BorderThickness="2.5"
                                    Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource Ink}">
                                <Path x:Name="Mark" Data="M 3.5,8.5 L 7,12 L 13.5,4.5" Stroke="#111111" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                            </Border>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderThickness" Value="3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Segmented choice (RadioButton) ================= -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,10,6" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border CornerRadius="6" Background="{DynamicResource Ink}">
                            <Border.RenderTransform>
                                <TranslateTransform X="3" Y="3" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="2.5"
                                Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource Ink}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="3" Y="3" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact segmented choice (Activity toolbar) -->
    <Style x:Key="SegmentSmall" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ================= Filter chip (RadioButton) ================= -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,10,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border CornerRadius="14" Background="{DynamicResource Ink}">
                            <Border.RenderTransform>
                                <TranslateTransform X="2.5" Y="2.5" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="14" Padding="11,4" BorderThickness="2"
                                Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource Ink}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipSelectedBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="2.5" Y="2.5" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Sidebar navigation (RadioButton) ================= -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="GroupName" Value="Nav" />
        <Setter Property="Margin" Value="12,3,16,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Shadow" CornerRadius="6" Background="{DynamicResource Ink}" Visibility="Hidden">
                            <Border.RenderTransform>
                                <TranslateTransform X="3" Y="3" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="6" Padding="12,8" BorderThickness="2.5"
                                Background="Transparent" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
                            <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Buttons ================= -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shadow" CornerRadius="6" Background="{DynamicResource Ink}">
                            <Border.RenderTransform>
                                <TranslateTransform X="4" Y="4" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="2.5"
                                Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Ink}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}" />
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="-1" Y="-1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="4" Y="4" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Shadow" Property="Visibility" Value="Hidden" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubtleButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,3,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="6" Background="{DynamicResource Ink}">
                            <Border.RenderTransform>
                                <TranslateTransform X="3" Y="3" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="2.5"
                                Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource Ink}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="3" Y="3" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text button that reads like a bold link -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="6,3" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window caption buttons (custom title bar) -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="2" BorderBrush="Transparent" CornerRadius="5" Margin="2,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="2" BorderBrush="Transparent" CornerRadius="5" Margin="2,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MutedFill}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
                            <Setter Property="Foreground" Value="#111111" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Dropdown (ComboBox) ================= -->
    <Style x:Key="DropdownItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Padding="10,6" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Dropdown" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Margin" Value="0,0,3,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DropdownItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border CornerRadius="6" Background="{DynamicResource Ink}">
                            <Border.RenderTransform>
                                <TranslateTransform X="3" Y="3" />
                            </Border.RenderTransform>
                        </Border>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="6" BorderThickness="2.5"
                                            Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource Ink}">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                              Data="M0,0 L5,5 L10,0" StrokeThickness="2.5" Stroke="{DynamicResource Ink}"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="12,0,30,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="None">
                            <Border Margin="0,6,6,6" Padding="4" CornerRadius="8" BorderThickness="2.5"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Ink}"
                                    Effect="{DynamicResource HardShadowSmall}">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Tooltip ================= -->
    <Style x:Key="ThemedToolTip" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Padding="10,6" CornerRadius="6" BorderThickness="2" Margin="0,0,4,4"
                            Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Ink}"
                            Effect="{DynamicResource HardShadowSmall}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Progress bar (update download) ================= -->
    <Style x:Key="BrutalProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="18" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Margin="0,0,3,3">
                        <Border CornerRadius="9" Background="{DynamicResource Ink}">
                            <Border.RenderTransform>
                                <TranslateTransform X="3" Y="3" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="PART_Track" CornerRadius="9" BorderThickness="2.5"
                                Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource Ink}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="7" Margin="3"
                                Background="{DynamicResource Accent}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Hyperlinks & scrollbars ================= -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextDecorations" Value="Underline" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="4" Margin="2,2" BorderThickness="2"
                                                Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Ink}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
